(* ------------------------------------------------------------------ *)
(* The Python subset this compiler accepts.                             *)
(*                                                                      *)
(* Every construct below has a deterministic codegen rule in            *)
(* src/codegen/rules.py. Anything outside this grammar is a syntax      *)
(* error, not something to hand to a language model.                    *)
(*                                                                      *)
(* Programs written in this subset are valid Python 3, so `python`      *)
(* itself is the correctness oracle for the generated C.                *)
(* ------------------------------------------------------------------ *)

program        = { import_stmt | function_def } ;

(* ------------------------------------------------------------------ *)
(* An import binds names; it never executes a module. There is no      *)
(* module object, nothing to run at import time and no file to read —  *)
(* the name is looked up in a fixed table (src/semantic/modules.py)    *)
(* and each member it brings in has a static C translation, the same   *)
(* contract as a builtin.                                              *)
(*                                                                     *)
(* Two modules exist. `math` maps onto <math.h>; importing it is also  *)
(* what makes `sqrt(x)` deterministic instead of AI-resolved. `gfx` is *)
(* the window/OpenGL shim in src/runtime/gfx.c, and importing it is    *)
(* what links that file in.                                            *)
(*                                                                     *)
(* Any other module is rejected by name with the reason. pygame and    *)
(* numpy fail because their APIs return objects and arrays, which this *)
(* subset has no way to hold — not because of the import syntax.       *)
(* ------------------------------------------------------------------ *)

import_stmt    = "import" dotted_name [ "as" IDENT ] NEWLINE
               | "from" dotted_name "import" ( "*" | import_list ) NEWLINE ;

import_list    = import_item { "," import_item } ;
import_item    = IDENT [ "as" IDENT ] ;
dotted_name    = IDENT { "." IDENT } ;

function_def   = "def" IDENT "(" [ param_list ] ")" "->" type ":" block ;

param_list     = param { "," param } ;
param          = IDENT ":" type ;
type           = "int" | "float" | "str" | "bool" | "None" | array_type ;

(* ------------------------------------------------------------------ *)
(* Fixed-size arrays are the one compound type here. The size is part  *)
(* of the C type, so it must be a literal and it never changes: there  *)
(* is no append, no slicing and no resizing. That is what lets an      *)
(* array be `py_int a[54]` on the stack, with no allocator behind it.  *)
(*                                                                     *)
(* A parameter's size is not known in the callee, because C arrays     *)
(* decay to pointers — so every array parameter is compiled to two,    *)
(* the pointer and its length, and len() reads the second.             *)
(* ------------------------------------------------------------------ *)

array_type     = "list" "[" ( "int" | "float" | "bool" ) "]" ;

array_init     = "[" expression { "," expression } [ "," ] "]"
               | "[" expression "]" "*" NUMBER ;
                 (* elements must be literals: it becomes a C initialiser *)

block          = NEWLINE INDENT [ STRING NEWLINE ] { statement } DEDENT ;
                 (* a leading string literal is a docstring, not a statement *)

statement      = assign_stmt
               | index_assign_stmt
               | aug_assign_stmt
               | if_stmt
               | while_stmt
               | for_stmt
               | return_stmt
               | print_stmt
               | break_stmt
               | continue_stmt
               | pass_stmt
               | expr_stmt ;

assign_stmt    = IDENT [ ":" type ] "=" expression NEWLINE ;
                 (* the annotation form pins a variable's type, e.g.
                    `total: float = 0` so that `total = total / n` is legal *)

aug_assign_stmt = IDENT aug_op expression NEWLINE ;
aug_op         = "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "**=" ;

if_stmt        = "if" expression ":" block
                 { "elif" expression ":" block }
                 [ "else" ":" block ] ;

while_stmt     = "while" expression ":" block ;

for_stmt       = "for" IDENT "in" "range" "(" expression
                                              [ "," expression
                                              [ "," expression ] ] ")" ":" block ;
                 (* range(stop) | range(start, stop) | range(start, stop, step) *)

return_stmt    = "return" [ expression ] NEWLINE ;
print_stmt     = "print" "(" [ arg_list ] ")" NEWLINE ;
break_stmt     = "break" NEWLINE ;
continue_stmt  = "continue" NEWLINE ;
pass_stmt      = "pass" NEWLINE ;
expr_stmt      = call_expr NEWLINE ;

(* Precedence, lowest to highest — matches CPython's. *)
expression     = bool_or ;
bool_or        = bool_and { "or" bool_and } ;
bool_and       = bool_not { "and" bool_not } ;
bool_not       = "not" bool_not | comparison ;
comparison     = arith [ ( "==" | "!=" | "<" | ">" | "<=" | ">=" ) arith ] ;
                 (* exactly one comparison: `a < b < c` is rejected, see below *)
arith          = term { ( "+" | "-" ) term } ;
term           = unary { ( "*" | "/" | "//" | "%" ) unary } ;
unary          = ( "-" | "+" ) unary | power ;
power          = atom [ "**" unary ] ;
                 (* right-associative, and binds tighter than a unary minus on
                    its left: -2 ** 2 is -4, and 2 ** -1 parses *)

index_assign_stmt = IDENT "[" expression "]" [ "+" | "-" | "*" | "/" | "%" ]
                    "=" expression NEWLINE ;

atom           = NUMBER | FLOAT | STRING
               | "True" | "False" | "None"
               | call_expr | module_const | index_expr
               | IDENT | "(" expression ")" ;

index_expr     = IDENT "[" expression "]" ;
                 (* a negative index counts from the end, as Python's does, *)
                 (* and an out-of-range one stops the program rather than   *)
                 (* reading whatever C would find at that address.          *)

call_expr      = [ IDENT "." ] IDENT "(" [ arg_list ] ")" ;
                 (* the qualified form is only valid on an imported module *)

module_const   = IDENT "." IDENT ;
                 (* math.pi and friends. A dot is legal only on a name an  *)
                 (* import bound; on anything else it is attribute access, *)
                 (* which this subset cannot express.                      *)
arg_list       = expression { "," expression } [ "," ] ;

(* ------------------------------------------------------------------ *)
(* Builtins with static C rules (src/semantic/builtins.py):            *)
(*                                                                      *)
(*   len(str) -> int          abs(x)          min(a, b, ...)            *)
(*   max(a, b, ...)           pow(a, b)       round(x [, ndigits])      *)
(*   int(x)  float(x)  bool(x)                                          *)
(*   put(str) -> None    writes a string with no newline and no         *)
(*                       separator; print() can end a line but cannot    *)
(*                       build one, and there is no concatenation        *)
(*                                                                      *)
(* A call to any *other* undefined name is a compile error. With --ai   *)
(* it is instead routed to the gate, which asks a local model for a C   *)
(* expression and rejects the answer unless it passes a safety check    *)
(* and compiles. That is the only place AI enters the pipeline.         *)
(* ------------------------------------------------------------------ *)

(* ------------------------------------------------------------------ *)
(* Deliberately excluded, and rejected with a message that says so:     *)
(*                                                                      *)
(*   classes, lists/dicts/sets/tuples, comprehensions, slicing,         *)
(*   decorators, lambdas, generators, exceptions, imports, closures,    *)
(*   nested defs, global/nonlocal, multiple or chained assignment,      *)
(*   chained comparison (a < b < c), string concatenation and           *)
(*   formatting, default and keyword arguments, while/else, for/else.   *)
(*                                                                      *)
(* String concatenation and str() are excluded specifically because     *)
(* they need heap allocation; the generated C has no allocator and no   *)
(* ownership model, and half-implementing one would be worse than       *)
(* saying no.                                                           *)
(* ------------------------------------------------------------------ *)

(* Documented behavioural limits of the generated C:                    *)
(*   - Python ints are arbitrary precision; py_int is 64-bit and wraps. *)
(*   - Recursion depth is the C stack's, not sys.getrecursionlimit().   *)
(*   - Everything else — /, //, %, **, round(), float repr, print       *)
(*     formatting, zero-division errors — matches CPython exactly, and  *)
(*     tests/test_e2e_harness.py diffs against CPython to prove it.     *)
