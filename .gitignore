__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.exe
*.o
*.out
out.c
history/
reports/*
!reports/.gitkeep
.venv/
venv/
env/
.pytest_cache/
*.tmp

# Secrets — never commit
.env
*.key
secrets/
openrouter_key.txt

# C produced by the compiler from a demo or test program. src/runtime/*.c is
# hand-written and stays tracked; these are build output.
demos/*.c
tests/programs/*.c
tests/programs/**/*.c

# A repair written by `--repair`: an artefact of a run, not source.
*.repaired.py

# Scratch output from the report builder.
tools/report/_build/

# Scratch output from the report polish pass.
tools/report/_polish/

# Scratch output from the slide deck build.
tools/ppt/node_modules/
tools/ppt/package-lock.json
tools/ppt/package.json
presentation/slide-*.jpg
presentation/screenshots/_build/
presentation/screenshots/_shot.ps1

# Office lock files, left behind while a document is open.
~$*

# Scratch output from the reference-document build.
tools/doc/node_modules/
tools/doc/package-lock.json
tools/doc/package.json
